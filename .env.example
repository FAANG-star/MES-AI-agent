# ---------------------------------------------------------------
# Smart CNC Factory MES Copilot — copy to .env and adjust
# ---------------------------------------------------------------

# --- Database ---
POSTGRES_USER=mes
POSTGRES_PASSWORD=mes
POSTGRES_DB=mes
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mes:mes@localhost:5432/mes
# Read-only role used by the MES tool layer (ADR-6); created by db/schema.sql footer.
MES_RO_PASSWORD=mes_ro
DATABASE_URL_RO=postgresql://mes_ro:mes_ro@localhost:5432/mes

# --- LLM provider (ADR-5: provider-abstracted, local-first) ---
# The factory's production environment is isolated, so the prototype runs a
# locally deployed open-weight model. Factory questions and MES data never
# leave the application environment.
#
# LLM_PROVIDER=openai_compatible | anthropic | none
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
# qwen2.5:7b-instruct measured 21/21 on every check here; 3b also passes and
# is ~4x faster. Verify your choice with `make llm-check`.
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
# Generous: a local model loads into memory on first use, and the server
# compiles a grammar for the JSON schema the first time it sees it.
LLM_TIMEOUT_S=180
# 0 makes a small model markedly more consistent. Local runtimes accept this;
# it is never sent to Claude, which rejects the parameter.
LLM_TEMPERATURE=0
# Empty = negotiate json_schema -> json_object -> prompt on first use.
# Pin it once `make llm-check` tells you what your endpoint supports.
LLM_STRUCTURED_MODE=

# Optional development reference only — not part of the client-facing
# architecture. Set LLM_PROVIDER=anthropic to compare against a hosted model.
# LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# With no provider reachable the agent falls back to deterministic rule-based
# understanding and labels every response degraded:true.

# --- Application ---
FACTORY_TIMEZONE=Asia/Tokyo
# Pin the factory calendar to a day (YYYY-MM-DD) to rehearse a demo. Leave empty.
FACTORY_TODAY=
API_PORT=8000
LOG_LEVEL=INFO

# --- Web interface ---
WEB_PORT=3000
# Where the *frontend server* finds the API. The browser never calls the
# backend directly: every request goes through the Next.js server, which is
# why there is no public API URL here and why CORS is not involved. Inside
# compose this is the service name; running `npm run dev` on the host it is
# localhost.
MES_API_URL=http://localhost:8000
