# ---------------------------------------------------------------
# Smart CNC Factory MES Copilot — copy to .env and adjust
# ---------------------------------------------------------------

# --- Database ---
POSTGRES_USER=mes
POSTGRES_PASSWORD=mes
POSTGRES_DB=mes
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mes:mes@localhost:5432/mes
# Read-only role used by the MES tool layer (ADR-6); created by db/schema.sql footer.
DATABASE_URL_RO=postgresql://mes_ro:change-me@localhost:5432/mes

# --- LLM provider (abstracted; see ADR-5) ---
# LLM_PROVIDER=anthropic | openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=

# On-prem / air-gapped path: any OpenAI-compatible endpoint (vLLM, Ollama, llama.cpp)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed

# --- Application ---
FACTORY_TIMEZONE=Asia/Tokyo
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
